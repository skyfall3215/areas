<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Center Control Panel (Shown before connection or on disconnect) -->
    <ScrollView
        android:id="@+id/controlOverlay"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_control_panel"
        android:elevation="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Header Row with Title & Version Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="v1.0.3"
                    android:textColor="#A78BFA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/status_disconnected"
                android:textAlignment="center"
                android:textColor="#BBBBCC"
                android:textSize="13sp" />

            <!-- Client Isolation / Error Alert Banner -->
            <TextView
                android:id="@+id/txtWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#44FF9800"
                android:padding="12dp"
                android:text=""
                android:textColor="#FFCC80"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Bitrate Limit Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yayın Bit Hızı Sınırı:"
                    android:textColor="#E0E0EA"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#00E676" />
            </LinearLayout>

            <!-- Mode 1: USB-C -->
            <Button
                android:id="@+id/btnConnectUsb"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/primary"
                android:text="@string/btn_connect_usb"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Mode 2: Mobile Hotspot (Direct Wireless 192.168.137.1) -->
            <Button
                android:id="@+id/btnConnectHotspot"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#EA580C"
                android:text="@string/btn_connect_hotspot"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Mode 3: Discovered Hosts -->
            <LinearLayout
                android:id="@+id/discoveredSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_discovered_pcs"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/discoveredContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Divider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:text="@string/header_or"
                android:textColor="#777788"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Mode 4: Wi-Fi LAN Manual IP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputIpAddress"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:digits="0123456789."
                    android:hint="@string/hint_ip_address"
                    android:inputType="number|numberDecimal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="#777788"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnConnectWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#16A34A"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/btn_connect_wifi"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Cancel Reconnect Button -->
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#DC2626"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Statistics & Connection Info Menu (Opened ONLY when user taps the Stats button; covers top-center & top-right info in one clean panel) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="76dp"
        android:background="@drawable/bg_stats_panel"
        android:elevation="12dp"
        android:minWidth="310dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtHudHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="📊 İSTATİSTİKLER &amp; TELEMETRİ"
                android:textColor="#A78BFA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="2dp"
                android:text="✕"
                android:textColor="#888899"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Merged Top-Center Stream Banner Info inside Stats Menu so it never blocks the top screen -->
        <TextView
            android:id="@+id/txtBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Yayın: --"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/txtHudFpsBitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="FPS: -- | Alınan: -- Mbps"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHudSentBitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Gönderilen: -- Mbps (0 pkt)"
            android:textColor="#81C784"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtHudEncode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="Encode: -- ms (Cap: -- ms)"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtHudNetwork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="Ağ (RTT/2): -- ms"
            android:textColor="#29B6F6"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtHudDecode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="Decode: -- ms"
            android:textColor="#FFCA28"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtHudLoss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="Kayıp: 0 pkt | Atılan: 0 | IDR: 0"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/txtHudTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Tahmini Gecikme: -- ms"
            android:textColor="#FF80AB"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Hidden input receiver for soft keyboard (Moonlight style IME capture) -->
    <EditText
        android:id="@+id/hiddenInputReceiver"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:alpha="0"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:imeOptions="flagNoExtractUi|actionNone"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textMultiLine" />

    <!-- Compact Floating Control Dock (Bottom-Right): Collapsible Keyboard + Stats Toggle + Disconnect/Exit -->
    <LinearLayout
        android:id="@+id/floatingControlDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="14dp"
        android:background="@drawable/bg_floating_bar"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/dockContentGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Virtual Keyboard Button -->
            <Button
                android:id="@+id/btnToggleKeyboard"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:backgroundTint="#00000000"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="⌨"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="#33FFFFFF" />

            <!-- Statistics Menu Toggle Button -->
            <Button
                android:id="@+id/btnToggleStats"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#00000000"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text="📊 İstatistik"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="#33FFFFFF" />

            <!-- Exit / Disconnect Button -->
            <Button
                android:id="@+id/btnDisconnectStream"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#00000000"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text="✕ Çıkış"
                android:textAllCaps="false"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="#33FFFFFF" />
        </LinearLayout>

        <!-- Collapse / Expand Dock Button (so taskbar clock & date stay visible) -->
        <Button
            android:id="@+id/btnDockCollapse"
            android:layout_width="34dp"
            android:layout_height="36dp"
            android:backgroundTint="#00000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="▶"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
