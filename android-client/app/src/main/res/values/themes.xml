<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SecondScreenClient" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_indigo</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_cyan</item>
        <item name="colorSecondaryVariant">@color/brand_violet</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:navigationBarColor">@color/surface_bg</item>
    </style>

    <style name="AreasBitrateChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/chip_bitrate_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">34dp</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipBackgroundColor">@color/chip_bitrate_bg</item>
        <item name="chipStrokeColor">@color/chip_bitrate_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="rippleColor">@color/ripple_cyan</item>
    </style>
</resources>
